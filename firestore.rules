rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'b60770329@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions
    function isValidUserProfile(data) {
      return data.keys().hasAll(['id', 'email', 'createdAt'])
        && data.keys().hasOnly(['id', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidApplication(data) {
      return data.keys().hasAll(['id', 'userId', 'email', 'name', 'track', 'status', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'email', 'name', 'track', 'comment', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.email is string && data.email.size() <= 256
        && data.name is string && data.name.size() <= 128
        && data.track is string && data.track.size() <= 64
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 2048))
        && data.status is string && data.status.size() <= 32
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    function isValidSavedModule(data) {
      return data.keys().hasAll(['id', 'userId', 'moduleId', 'savedAt'])
        && data.keys().hasOnly(['id', 'userId', 'moduleId', 'savedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.moduleId is number && data.moduleId >= 1 && data.moduleId <= 6
        && data.savedAt is string && data.savedAt.size() <= 64;
    }

    function isValidMvpProject(data) {
      return data.keys().hasAll(['id', 'userId', 'title', 'concept', 'techStack', 'starterPrompt', 'createdAt'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'concept', 'techStack', 'starterPrompt', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.title is string && data.title.size() <= 256
        && data.concept is string && data.concept.size() <= 2048
        && data.techStack is string && data.techStack.size() <= 1024
        && data.starterPrompt is string && data.starterPrompt.size() <= 4096
        && data.createdAt is string && data.createdAt.size() <= 64;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow update: if isOwner(userId) && isValidUserProfile(incoming()) && incoming().id == userId;
      allow delete: if isAdmin();
    }

    // Course applications
    match /applications/{applicationId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(applicationId) && incoming().userId == request.auth.uid && isValidApplication(incoming());
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && isValidApplication(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Saved curriculum modules
    match /saved_modules/{savedModuleId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(savedModuleId) && incoming().userId == request.auth.uid && isValidSavedModule(incoming());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Saved MVP projects
    match /mvp_projects/{projectId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(projectId) && incoming().userId == request.auth.uid && isValidMvpProject(incoming());
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && isValidMvpProject(incoming()) && incoming().userId == resource.data.userId;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
